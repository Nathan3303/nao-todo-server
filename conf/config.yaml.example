server:
    ip: 0.0.0.0
    port: 3000
    version: 1.0
    jwtSecret: "todolist-dddd"

mysql:
    host: 127.0.0.1
    port: 3306
    database: todolist
    username: todolist
    password: todolist
    charset: utf8mb4
    parseTime: true
    loc: Local

redis:
    host: 127.0.0.1
    port: 6379
    database: 4
    password: 123456
    network: "tcp"

log:
    level: info
    filePath: logs/app.log
    maxSize: 100
    maxAge: 30
    maxBackups: 10
    compress: true
    outputConsole: true
