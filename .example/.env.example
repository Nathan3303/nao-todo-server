JWT_SECRET=YOUR_JWT_SECRET
TZ=Asia/Shanghai

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=naotodo

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DB=0
# 会话清理（nao-todo-server#56）：回滚 = SESSION_CLEANUP_ENABLED=false + 重启
SESSION_CLEANUP_ENABLED=true
SESSION_CLEANUP_CRON="10 3 * * *"
SESSION_CLEANUP_RETENTION_DAYS=7
SESSION_CLEANUP_REVOKED_RETENTION_HOURS=24
SESSION_CLEANUP_BATCH_SIZE=500
SESSION_CLEANUP_MAX_BATCHES=20
SESSION_CLEANUP_RUN_ON_START=false
