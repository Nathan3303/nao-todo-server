# Go .gitignore file

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
*.prof

# Dependency directories
vendor/
Godeps/
go.sum

# Go workspace file
go.work

# IDE specific files (VSCode)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Debug files
debug
__debug_bin

# Output directories
bin/
dist/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Log files
*.log

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db